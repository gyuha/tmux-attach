{
  "name": "tmux-attach",
  "version": "0.1.0",
  "description": "A CLI to quickly choose and enter tmux sessions",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "bin": {
    "tmux-attach": "./dist/index.js",
    "ta": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "preinstall": "node -e \"const ua = process.env.npm_config_user_agent || ''; if (!ua.startsWith('pnpm/')) { console.error('This project uses pnpm only.'); process.exit(1); }\"",
    "publish:package": "pnpm publish",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "tmux",
    "cli",
    "session",
    "picker"
  ],
  "author": "gyuha",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.12",
    "@vitest/coverage-v8": "^3.0.0",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "ink": "^5.0.0",
    "react": "^18.3.1"
  }
}
